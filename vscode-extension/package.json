{
  "name": "report-designer",
  "displayName": "Report Designer",
  "description": "Design Handlebars PDF report templates (.zrpt) inside VS Code",
  "version": "0.1.0",
  "publisher": "tofilagman",
  "license": "MIT",
  "icon": "media/icon.png",
  "author": "tofi lagman <tofilagman@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tofilagman/report-designer.git"
  },
  "bugs": {
    "url": "https://github.com/tofilagman/report-designer/issues"
  },
  "homepage": "https://github.com/tofilagman/report-designer/tree/master/vscode-extension#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "report",
    "pdf",
    "handlebars",
    "template",
    "designer",
    "zrpt",
    "puppeteer"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/report-designer.toml"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "reportDesigner.zrpt",
        "displayName": "Report Designer",
        "selector": [
          {
            "filenamePattern": "*.zrpt"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "reportDesigner.newReport",
        "title": "New Report",
        "category": "Report Designer"
      },
      {
        "command": "reportDesigner.createConfig",
        "title": "Create Project Config",
        "category": "Report Designer"
      },
      {
        "command": "reportDesigner.preview",
        "title": "Preview Report",
        "category": "Report Designer",
        "icon": "$(play)"
      },
      {
        "command": "reportDesigner.publish",
        "title": "Publish Report",
        "category": "Report Designer",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "reportDesigner.publishTo",
        "title": "Publish Report to Target...",
        "category": "Report Designer"
      },
      {
        "command": "reportDesigner.syncLibs",
        "title": "Sync Libraries to Server",
        "category": "Report Designer"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "reportDesigner.preview",
          "when": "activeCustomEditorId == reportDesigner.zrpt",
          "group": "navigation@1"
        },
        {
          "command": "reportDesigner.publish",
          "when": "activeCustomEditorId == reportDesigner.zrpt",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "reportDesigner.newReport",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "reportDesigner.createConfig",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "reportDesigner.preview",
          "when": "activeCustomEditorId == reportDesigner.zrpt"
        },
        {
          "command": "reportDesigner.publish",
          "when": "activeCustomEditorId == reportDesigner.zrpt"
        },
        {
          "command": "reportDesigner.publishTo",
          "when": "activeCustomEditorId == reportDesigner.zrpt"
        },
        {
          "command": "reportDesigner.syncLibs",
          "when": "activeCustomEditorId == reportDesigner.zrpt"
        }
      ]
    },
    "configuration": {
      "title": "Report Designer",
      "properties": {
        "reportDesigner.chromePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to a Chrome or Chromium executable used for rendering. Leave empty to auto-detect. A `[render] chrome_path` in `report-designer.toml` takes precedence."
        }
      }
    },
    "languages": [
      {
        "id": "toml",
        "filenames": [
          "report-designer.toml"
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs --tests && node --test \"out-test/*.test.js\"",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "dependencies": {
    "bson": "^6.10.4",
    "preact": "^10.29.8",
    "puppeteer-core": "^24.14.0",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "handlebars": "^4.7.8",
    "monaco-editor": "0.54.0",
    "pdfjs-dist": "3.11.174",
    "typescript": "^5.6.0"
  }
}
